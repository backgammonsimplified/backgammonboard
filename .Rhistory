setwd("~/backgammonboard")
getwd()
file.exists("DESCRIPTION")
read.dcf("DESCRIPTION")[, c("Package", "Version")]
needed <- c("devtools", "testthat", "roxygen2")
missing <- setdiff(
needed,
rownames(installed.packages())
)
if (length(missing) > 0) {
install.packages(missing)
}
devtools::document()
devtools::load_all()
devtools::test()
opening_xgid <- paste0(
"XGID=-b----E-C---eE---c-e----B-",
":0:0:1:52:0:0:3:0:10"
)
opening <- backgammon_position(opening_xgid)
opening
opening$points
opening$bar
opening$off
opening$on_roll
opening$dice
opening$cube_value
opening$cube_owner
opening$play_context
asymmetric_xgid <- paste0(
"XGID=aFDaA--------------a-Acbb-",
":1:-1:1:42:3:0:0:7:10"
)
asymmetric <- backgammon_position(asymmetric_xgid)
asymmetric
asymmetric$points
asymmetric$bar
asymmetric$off
asymmetric$cube_value
asymmetric$cube_owner
devtools::check()
devtools::document()
devtools::test()
devtools::check()
devtools::document()
devtools::test()
devtools::check()
devtools::document()
devtools::test()
devtools::check()
