% Generated by hand for the XGID render integration checkpoint.
\name{ggboard}
\alias{ggboard}
\title{Render a factual backgammon board from a complete XGID}
\usage{
ggboard(
  x,
  colors = board_colors("default"),
  style = board_style("default"),
  decision = c("auto", "checker_play", "roll_double", "take_pass", "none"),
  perspective = c("decision_maker", "on_roll", "white", "black"),
  score_format = c("away", "raw", "both"),
  show_information = TRUE,
  brand_text = NULL
)
}
\arguments{
\item{x}{A complete XGID string or a \code{backgammon_position}.}
\item{colors}{A validated object created by \code{board_colors()}.}
\item{style}{A validated object created by \code{board_style()}.}
\item{decision}{One of \code{"auto"}, \code{"checker_play"},
\code{"roll_double"}, \code{"take_pass"}, or \code{"none"}. Auto never
infers a cube question.}
\item{perspective}{One of \code{"decision_maker"}, \code{"on_roll"},
\code{"white"}, or \code{"black"}.}
\item{score_format}{Match score display format: \code{"away"},
\code{"raw"}, or \code{"both"}.}
\item{show_information}{Whether score, pip, and status information is drawn.}
\item{brand_text}{Optional static brand text. The neutral default is
\code{NULL}.}
}
\value{
An ordinary object inheriting from \code{ggplot}.
}
\description{
Validates and constructs a factual position, resolves any factual pending cube
offer and optional instructional context, applies one semantic perspective,
and renders a static board. Perspective never mutates factual position state.
}
